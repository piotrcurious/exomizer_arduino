#include "exomizer_decompress.h"

// Example crunched data (Repetitive string)
const uint8_t crunched_data[] = {
  0x00, 0x01, 0x01, 0x02, 0x02, 0x03, 0x03, 0x04, 0x04, 0x05, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a,
  0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f, 0x0f, 0x0f, 0x0f, 0x0f,
  0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f, 0x0f, 0x0f, 0x0f,
  0x02, 0x03, 0x04, 0x05, 0xfe, 0x41, 0x42, 0x43, 0x01, 0x00, 0x02, 0x00, 0x03, 0x00, 0x04, 0x00,
  0x01, 0x10, 0x00
};

void my_write_cb(void* userdata, uint8_t byte) {
    Serial.print((char)byte);
}

void setup() {
    Serial.begin(115200);
    while (!Serial);

    Serial.println("\nMemoryless Decompression Example");
    Serial.println("Decompressing without a sliding window buffer...");

    // Memoryless decompression does not require a history buffer
    size_t total = exod_decrunch_memoryless(crunched_data, sizeof(crunched_data), my_write_cb, NULL, false);

    Serial.print("\nTotal bytes decompressed: ");
    Serial.println(total);
}

void loop() {}
